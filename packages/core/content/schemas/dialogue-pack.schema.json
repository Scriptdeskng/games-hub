{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naija-games/schemas/dialogue-pack.schema.json",
  "title": "DialoguePack",
  "$comment": "Rules JSON Schema cannot express are TypeScript-only and the TypeScript validator in packages/core/src/content/story is authoritative for them: uniqueness of ids inside an array of objects, option strings distinct ignoring case, and cross-field comparisons (a date range ending before it starts, a chapter depending on itself). scripts/content-schemas.test.ts keeps the two in agreement for everything else. Lengths are Unicode code points in both (2020-12 maxLength counts code points). A non-empty string must contain a non-whitespace character. reviewed:true requires a reviewedBy that does not start with TODO, TBD, pending, n/a or none. native_review is required when the line has yo, ig or ha text or lists them in langs; pcm_review is required when the line has pcm text or lists pcm in langs. Also TS-only: scene and line ids unique inside the pack.",
  "type": "object",
  "required": ["version", "kind", "id", "campaign", "chapter", "scenes"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "kind": {
      "const": "dialogue"
    },
    "campaign": {
      "enum": ["kiriji", "ekumeku", "moremi-prologue"]
    },
    "chapter": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "loc": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "\\S"
        },
        "pcm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "\\S"
        },
        "yo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "\\S"
        },
        "ig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "\\S"
        },
        "ha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "\\S"
        }
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "tag", "lines"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "tag": {
          "enum": ["History", "Legend", "Story"]
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          },
          "minItems": 1
        }
      }
    },
    "line": {
      "type": "object",
      "required": ["id", "speaker", "text", "langs"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "speaker": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "text": {
          "$ref": "#/$defs/loc"
        },
        "langs": {
          "type": "array",
          "items": {
            "enum": ["en", "pcm", "yo", "ig", "ha"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "native_review": {
          "type": "boolean"
        },
        "pcm_review": {
          "type": "boolean"
        },
        "fictional": {
          "type": "boolean"
        },
        "tag": {
          "enum": ["History", "Legend", "Story"]
        }
      },
      "allOf": [
        {
          "$comment": "native_review is required for yo text",
          "if": {
            "properties": {
              "langs": {
                "contains": {
                  "const": "yo"
                }
              }
            },
            "required": ["langs"]
          },
          "then": {
            "required": ["native_review"]
          }
        },
        {
          "if": {
            "properties": {
              "text": {
                "required": ["yo"]
              }
            },
            "required": ["text"]
          },
          "then": {
            "required": ["native_review"]
          }
        },
        {
          "$comment": "native_review is required for ig text",
          "if": {
            "properties": {
              "langs": {
                "contains": {
                  "const": "ig"
                }
              }
            },
            "required": ["langs"]
          },
          "then": {
            "required": ["native_review"]
          }
        },
        {
          "if": {
            "properties": {
              "text": {
                "required": ["ig"]
              }
            },
            "required": ["text"]
          },
          "then": {
            "required": ["native_review"]
          }
        },
        {
          "$comment": "native_review is required for ha text",
          "if": {
            "properties": {
              "langs": {
                "contains": {
                  "const": "ha"
                }
              }
            },
            "required": ["langs"]
          },
          "then": {
            "required": ["native_review"]
          }
        },
        {
          "if": {
            "properties": {
              "text": {
                "required": ["ha"]
              }
            },
            "required": ["text"]
          },
          "then": {
            "required": ["native_review"]
          }
        },
        {
          "$comment": "pcm_review is required for Pidgin text",
          "if": {
            "properties": {
              "langs": {
                "contains": {
                  "const": "pcm"
                }
              }
            },
            "required": ["langs"]
          },
          "then": {
            "required": ["pcm_review"]
          }
        },
        {
          "if": {
            "properties": {
              "text": {
                "required": ["pcm"]
              }
            },
            "required": ["text"]
          },
          "then": {
            "required": ["pcm_review"]
          }
        }
      ]
    }
  }
}
