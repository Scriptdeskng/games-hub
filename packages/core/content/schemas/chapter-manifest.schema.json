{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naija-games/schemas/chapter-manifest.schema.json",
  "title": "ChapterManifest",
  "type": "object",
  "required": [
    "version",
    "kind",
    "id",
    "campaign",
    "order",
    "title",
    "tag",
    "goals",
    "environment",
    "hero",
    "companions",
    "objectives",
    "heroMoment",
    "dates",
    "dependencies",
    "delivery",
    "content",
    "source",
    "reviewedBy",
    "reviewed"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "kind": {
      "const": "chapter"
    },
    "campaign": {
      "enum": ["kiriji", "ekumeku", "moremi-prologue"]
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "title": {
      "$ref": "#/$defs/loc60"
    },
    "tag": {
      "enum": ["History", "Legend", "Story"]
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/loc140"
      },
      "minItems": 1,
      "maxItems": 4
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "hero": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "companions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      },
      "uniqueItems": true
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      },
      "uniqueItems": true
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "text"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "escort",
              "defend",
              "hold",
              "raid",
              "stealth",
              "ambush",
              "relay",
              "protect",
              "choice",
              "cut",
              "survive"
            ]
          },
          "text": {
            "$ref": "#/$defs/loc120"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      },
      "minItems": 1
    },
    "heroMoment": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["brawl", "duel", "aim", "chase", "rhythm", "stealth", "escape"]
        },
        "text": {
          "$ref": "#/$defs/loc120"
        }
      }
    },
    "dates": {
      "$ref": "#/$defs/dateRange"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      },
      "uniqueItems": true
    },
    "delivery": {
      "enum": ["initial", "pack"]
    },
    "pack": {
      "type": "string",
      "pattern": "^ch\\d{2}$"
    },
    "packBudgetKb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "featureFlag": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]{0,39}$"
    },
    "content": {
      "type": "object",
      "required": ["scenes", "facts", "sources", "twoSides", "pins", "checks"],
      "additionalProperties": false,
      "properties": {
        "scenes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "twoSides": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "pins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1
    },
    "reviewed": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "delivery": {
            "const": "pack"
          }
        },
        "required": ["delivery"]
      },
      "then": {
        "required": ["pack", "packBudgetKb"]
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "const": "initial"
          }
        },
        "required": ["delivery"]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": ["pack"]
            },
            {
              "required": ["packBudgetKb"]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "loc60": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "pcm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "yo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "ig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "ha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      }
    },
    "loc120": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "pcm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "yo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "loc140": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "pcm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "yo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "ig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "ha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        }
      }
    },
    "histDate": {
      "type": "object",
      "required": ["year"],
      "additionalProperties": false,
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1950
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      }
    },
    "dateRange": {
      "type": "object",
      "required": ["start"],
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/histDate"
        },
        "end": {
          "$ref": "#/$defs/histDate"
        },
        "circa": {
          "type": "boolean"
        },
        "sourcesDisagree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
