{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naija-games/schemas/learning-pack.schema.json",
  "title": "LearningPack",
  "$comment": "Rules JSON Schema cannot express are TypeScript-only and the TypeScript validator in packages/core/src/content/story is authoritative for them: uniqueness of ids inside an array of objects, option strings distinct ignoring case, and cross-field comparisons (a date range ending before it starts, a chapter depending on itself). scripts/content-schemas.test.ts keeps the two in agreement for everything else. Lengths are Unicode code points in both (2020-12 maxLength counts code points). A non-empty string must contain a non-whitespace character. reviewed:true requires a reviewedBy that does not start with TODO, TBD, pending, n/a or none. Also TS-only: ids unique inside each array, date range end before start, check options distinct ignoring case.",
  "type": "object",
  "required": [
    "version",
    "kind",
    "id",
    "campaign",
    "chapter",
    "facts",
    "sources",
    "twoSides",
    "pins",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "kind": {
      "const": "learning"
    },
    "campaign": {
      "enum": ["kiriji", "ekumeku", "moremi-prologue"]
    },
    "chapter": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "twoSides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/twoSides"
      }
    },
    "pins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "loc140": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "pattern": "\\S"
        },
        "pcm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "pattern": "\\S"
        },
        "yo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "pattern": "\\S"
        },
        "ig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "pattern": "\\S"
        },
        "ha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "pattern": "\\S"
        }
      }
    },
    "loc200": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "pcm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "yo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "ig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "ha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      }
    },
    "loc220": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "\\S"
        },
        "pcm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "\\S"
        },
        "yo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "\\S"
        },
        "ig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "\\S"
        },
        "ha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "\\S"
        }
      }
    },
    "loc80": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "pcm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "yo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "ig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "ha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        }
      }
    },
    "loc60": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "\\S"
        },
        "pcm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "\\S"
        },
        "yo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "\\S"
        },
        "ig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "\\S"
        },
        "ha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "\\S"
        }
      }
    },
    "dateRange": {
      "type": "object",
      "required": ["start"],
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/histDate"
        },
        "end": {
          "$ref": "#/$defs/histDate"
        },
        "circa": {
          "type": "boolean"
        },
        "sourcesDisagree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      }
    },
    "histDate": {
      "type": "object",
      "required": ["year"],
      "additionalProperties": false,
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1950
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      },
      "allOf": [
        {
          "$comment": "a day needs a month",
          "if": {
            "required": ["day"]
          },
          "then": {
            "required": ["month"]
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "required": ["id", "trigger", "text", "tag", "source", "reviewedBy", "reviewed"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "trigger": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "text": {
          "$ref": "#/$defs/loc140"
        },
        "tag": {
          "enum": ["History", "Legend", "Story"]
        },
        "sourceRef": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "$comment": "reviewed:true needs a real reviewer, not a placeholder",
          "if": {
            "properties": {
              "reviewed": {
                "const": true
              }
            },
            "required": ["reviewed"]
          },
          "then": {
            "properties": {
              "reviewedBy": {
                "not": {
                  "pattern": "^\\s*(?:[tT][oO][dD][oO]|[tT][bB][dD]|[pP][eE][nN][dD][iI][nN][gG]|[nN]/[aA]|[nN][oO][nN][eE])\\b"
                }
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "author",
        "when",
        "why",
        "citation",
        "codex",
        "tag",
        "source",
        "reviewedBy",
        "reviewed"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "why": {
          "$ref": "#/$defs/loc200"
        },
        "citation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "codex": {
          "type": "object",
          "required": ["shelf", "slot"],
          "additionalProperties": false,
          "properties": {
            "shelf": {
              "enum": ["documents", "books", "objects", "oral-history"]
            },
            "slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          }
        },
        "tag": {
          "enum": ["History", "Legend", "Story"]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "$comment": "reviewed:true needs a real reviewer, not a placeholder",
          "if": {
            "properties": {
              "reviewed": {
                "const": true
              }
            },
            "required": ["reviewed"]
          },
          "then": {
            "properties": {
              "reviewedBy": {
                "not": {
                  "pattern": "^\\s*(?:[tT][oO][dD][oO]|[tT][bB][dD]|[pP][eE][nN][dD][iI][nN][gG]|[nN]/[aA]|[nN][oO][nN][eE])\\b"
                }
              }
            }
          }
        }
      ]
    },
    "twoSides": {
      "type": "object",
      "required": ["id", "event", "sides", "tag", "source", "reviewedBy", "reviewed"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "event": {
          "$ref": "#/$defs/loc80"
        },
        "tag": {
          "enum": ["History", "Legend", "Story"]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewed": {
          "type": "boolean"
        },
        "sides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "account", "basis"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "\\S"
              },
              "account": {
                "$ref": "#/$defs/loc220"
              },
              "basis": {
                "enum": ["oral", "written", "official-report", "tradition"]
              }
            }
          },
          "minItems": 2,
          "maxItems": 3
        }
      },
      "allOf": [
        {
          "$comment": "reviewed:true needs a real reviewer, not a placeholder",
          "if": {
            "properties": {
              "reviewed": {
                "const": true
              }
            },
            "required": ["reviewed"]
          },
          "then": {
            "properties": {
              "reviewedBy": {
                "not": {
                  "pattern": "^\\s*(?:[tT][oO][dD][oO]|[tT][bB][dD]|[pP][eE][nN][dD][iI][nN][gG]|[nN]/[aA]|[nN][oO][nN][eE])\\b"
                }
              }
            }
          }
        }
      ]
    },
    "pin": {
      "type": "object",
      "required": ["id", "kind", "label", "date", "tag", "source", "reviewedBy", "reviewed"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "kind": {
          "enum": ["timeline", "map", "both"]
        },
        "label": {
          "$ref": "#/$defs/loc60"
        },
        "date": {
          "$ref": "#/$defs/dateRange"
        },
        "tag": {
          "enum": ["History", "Legend", "Story"]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewed": {
          "type": "boolean"
        },
        "place": {
          "type": "object",
          "required": ["name", "x", "y"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "pattern": "\\S"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["map", "both"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["place"]
          }
        },
        {
          "$comment": "reviewed:true needs a real reviewer, not a placeholder",
          "if": {
            "properties": {
              "reviewed": {
                "const": true
              }
            },
            "required": ["reviewed"]
          },
          "then": {
            "properties": {
              "reviewedBy": {
                "not": {
                  "pattern": "^\\s*(?:[tT][oO][dD][oO]|[tT][bB][dD]|[pP][eE][nN][dD][iI][nN][gG]|[nN]/[aA]|[nN][oO][nN][eE])\\b"
                }
              }
            }
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "category",
        "difficulty",
        "q",
        "options",
        "answer",
        "explanation",
        "source",
        "reviewedBy",
        "reviewed"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "difficulty": {
          "enum": ["easy", "medium", "hard"]
        },
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "pattern": "\\S"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "\\S"
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "answer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "$comment": "reviewed:true needs a real reviewer, not a placeholder",
          "if": {
            "properties": {
              "reviewed": {
                "const": true
              }
            },
            "required": ["reviewed"]
          },
          "then": {
            "properties": {
              "reviewedBy": {
                "not": {
                  "pattern": "^\\s*(?:[tT][oO][dD][oO]|[tT][bB][dD]|[pP][eE][nN][dD][iI][nN][gG]|[nN]/[aA]|[nN][oO][nN][eE])\\b"
                }
              }
            }
          }
        }
      ]
    }
  }
}
