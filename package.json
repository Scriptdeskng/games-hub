{
  "name": "naija-games-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "new-game": "node scripts/new-game.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "vitest run",
    "build": "node scripts/build-all.mjs",
    "size": "node scripts/size-budget.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:extra": "node scripts/e2e.mjs --extra",
    "mock-portal": "node scripts/mock-portal-server.mjs",
    "check": "npm run lint && npm run typecheck && npm run i18n:check && npm run test:cov && npm run build && npm run size && npm run e2e && npm run e2e:perf",
    "e2e:perf": "node scripts/e2e.mjs --perf",
    "e2e:soak": "node scripts/e2e.mjs --soak",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
