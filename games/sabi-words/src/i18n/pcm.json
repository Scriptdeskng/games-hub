{
  "game.title": "Sabi Words",
  "game.tagline": {
    "text": "Find di hidden words before time finish.",
    "_review": true
  },
  "game.howto.1": {
    "text": "Swipe for di letters for straight line, any side, to circle di hidden word. Word fit run front or back.",
    "_review": true
  },
  "game.howto.2": {
    "text": "You no want swipe? Tap di first letter, then tap di last letter. For keyboard, use arrow keys move, press Enter or Space to mark where e start and where e end.",
    "_review": true
  },
  "game.howto.3": {
    "text": "You dey stuck? Di lantern go show di first letter of one word, e cost 10 coins. Coins na just for fun, you go win dem when you finish puzzle. Press H for hint.",
    "_review": true
  },
  "game.howto.4": {
    "text": "Beat di clock: if half of di time still remain you go get 3 stars, if one-fifth remain na 2 stars, and 1 star if you just finish. If time don finish, you lose di round.",
    "_review": true
  },
  "game.howto.5": {
    "text": "Pick one of di six word packs for menu. Daily Puzzle na di same one for everybody today: your first try na im count, di next ones na practice. Press P to pause.",
    "_review": true
  },
